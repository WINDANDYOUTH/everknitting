{
  "name": "everknitting-outbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "postal-mime": "^2.4.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.136.3"
  }
}
